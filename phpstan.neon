includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    # Test Pest ditulis sebagai closure yang di-bind saat runtime, sehingga
    # PHPStan tidak bisa mengenali method $this->... di dalamnya (positif
    # palsu). Test sudah diverifikasi oleh Pest, bukan static analysis.
    excludePaths:
        - tests/*

    level: 7
